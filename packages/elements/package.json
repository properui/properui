{
    "name": "@properui/elements",
    "version": "0.1.0",
    "description": "Proper UI as framework-agnostic custom elements (<pui-button>, <pui-modal>, ...) for Vue, Angular, Svelte, Astro and plain HTML. Light DOM, no framework runtime.",
    "keywords": [
        "custom-elements",
        "web-components",
        "vue",
        "angular",
        "svelte",
        "astro",
        "tailwindcss",
        "design-system",
        "components"
    ],
    "license": "MIT",
    "author": "Ayman Shabaro (https://github.com/aymanshabaro)",
    "homepage": "https://github.com/properui/properui#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/properui/properui.git",
        "directory": "packages/elements"
    },
    "bugs": {
        "url": "https://github.com/properui/properui/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "sideEffects": [
        "./dist/register.js",
        "./dist/chunk-*.js",
        "./dist/properui-elements.global.js"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "unpkg": "./dist/properui-elements.global.js",
    "jsdelivr": "./dist/properui-elements.global.js",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./register": {
            "types": "./dist/register.d.ts",
            "import": "./dist/register.js"
        },
        "./vue": {
            "types": "./types/vue.d.ts",
            "default": "./types/empty.js"
        },
        "./react": {
            "types": "./types/react.d.ts",
            "default": "./types/empty.js"
        },
        "./global": "./dist/properui-elements.global.js",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "types",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
        "lint": "eslint src test",
        "type-check": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@properui/html": "workspace:*"
    },
    "devDependencies": {
        "axe-core": "^4.10.2",
        "jsdom": "^25.0.1",
        "tsup": "^8.3.5",
        "typescript": "^5.9.3",
        "vitest": "^2.1.8"
    }
}
