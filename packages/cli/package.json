{
    "name": "@properui/cli",
    "version": "0.3.0",
    "description": "CLI that copies Proper UI components into your React or Next.js project, shadcn-style.",
    "keywords": [
        "cli",
        "react",
        "react-aria",
        "tailwindcss",
        "design-system",
        "components",
        "ui",
        "scaffolding"
    ],
    "license": "MIT",
    "author": "Ayman Shabaro (https://github.com/aymanshabaro)",
    "homepage": "https://github.com/properui/properui#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/properui/properui.git",
        "directory": "packages/cli"
    },
    "bugs": {
        "url": "https://github.com/properui/properui/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "bin": {
        "properui": "./dist/index.js"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsup src/index.ts --format esm --clean",
        "lint": "eslint src",
        "type-check": "tsc --noEmit",
        "test": "tsx scripts/smoke.ts",
        "smoke": "tsx scripts/smoke.ts"
    },
    "dependencies": {
        "commander": "^12.1.0",
        "kleur": "^4.1.5",
        "ora": "^8.1.1",
        "prompts": "^2.4.2"
    },
    "devDependencies": {
        "@types/prompts": "^2.4.9",
        "tsup": "^8.3.5",
        "typescript": "^5.9.3"
    }
}
