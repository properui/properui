{
    "name": "@properui/ui",
    "version": "0.3.0",
    "description": "Accessible React 19 component library built on React Aria Components and Tailwind CSS v4, shipped as source TSX.",
    "keywords": [
        "react",
        "react-aria",
        "tailwindcss",
        "design-system",
        "components",
        "ui",
        "accessible",
        "typescript"
    ],
    "license": "MIT",
    "author": "Ayman Shabaro (https://github.com/aymanshabaro)",
    "homepage": "https://github.com/properui/properui#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/properui/properui.git",
        "directory": "packages/ui"
    },
    "bugs": {
        "url": "https://github.com/properui/properui/issues"
    },
    "private": false,
    "publishConfig": {
        "access": "public"
    },
    "sideEffects": [
        "*.css"
    ],
    "type": "module",
    "files": [
        "src",
        "!src/**/*.test.*",
        "!src/**/*.story.*",
        "!src/**/*.stories.*",
        "!src/**/*.demo.*",
        "!src/vitest-axe.d.ts",
        "README.md",
        "LICENSE"
    ],
    "exports": {
        "./components/*": "./src/components/*.tsx",
        "./hooks/*": "./src/hooks/*.ts",
        "./utils/countries": "./src/utils/countries.tsx",
        "./utils/timezones": "./src/utils/timezones.tsx",
        "./utils/*": "./src/utils/*.ts",
        "./providers": "./src/providers/index.ts",
        "./providers/*": "./src/providers/*.tsx",
        "./next": "./src/next.ts",
        "./styles/presets": "./src/styles/presets.ts",
        "./styles/*": "./src/styles/*",
        ".": "./src/index.ts"
    },
    "scripts": {
        "lint": "eslint src",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@internationalized/date": "^3.12.3",
        "@react-aria/utils": "^3.34.1",
        "@react-stately/utils": "^3.12.1",
        "@properui/icons": "npm:@untitledui/icons@^0.0.22",
        "@untitledui/file-icons": "^0.0.9",
        "embla-carousel-react": "^8.6.0",
        "input-otp": "^1.4.2",
        "motion": "^12.42.2",
        "next-themes": "^0.4.6",
        "qr-code-styling": "^1.9.2",
        "react-aria": "^3.51.0",
        "react-aria-components": "^1.20.0",
        "react-hook-form": "^7.82.0",
        "recharts": "^3.10.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.6.0",
        "zod": "^4.4.3"
    },
    "peerDependencies": {
        "next": "^15.1.0",
        "react": "^19",
        "react-dom": "^19",
        "tailwindcss": "^4.3.0"
    },
    "peerDependenciesMeta": {
        "next": {
            "optional": true
        }
    },
    "devDependencies": {
        "@react-types/shared": "^3.36.1",
        "@tailwindcss/typography": "^0.5.20",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.1.0",
        "@types/react": "^19.2.17",
        "jsdom": "^25.0.1",
        "tailwindcss": "^4.3.3",
        "tailwindcss-animate": "^1.0.7",
        "tailwindcss-react-aria-components": "^2.2.0",
        "vitest": "^2.1.8",
        "vitest-axe": "^0.1.0"
    }
}
