{
    "$schema": "https://turbo.build/schema.json",
    "extends": ["//"],
    "tasks": {
        "build": {
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/ui/src/styles/**", "$TURBO_ROOT$/packages/html/src/**"],
