{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "bundler",
        "strict": true,
        "skipLibCheck": true,
        "experimentalDecorators": true,
        "lib": ["ES2022", "DOM"],
        "outDir": "./dist/out-tsc"
    },
    "angularCompilerOptions": {
        "strictTemplates": true,
        "strictInjectionParameters": true
    },
    "files": ["src/main.ts"]
}
